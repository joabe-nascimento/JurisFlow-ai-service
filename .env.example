# JurisFlow AI Service - Configuração

# ═══════════════════════════════════════════════════════════
# LLM PROVIDER
# ═══════════════════════════════════════════════════════════
# Opções: groq | openrouter | azure | openai
LLM_PROVIDER=openrouter

# ═══════════════════════════════════════════════════════════
# GROQ (GRÁTIS) — https://console.groq.com/keys
# ═══════════════════════════════════════════════════════════
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════════════
# OPENROUTER (GRÁTIS + PAGO) — https://openrouter.ai/keys
# ═══════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=JurisFlow

# ═══════════════════════════════════════════════════════════
# AZURE OPENAI (PAGO) — para produção
# ═══════════════════════════════════════════════════════════
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_DEPLOYMENT_NAME=gpt-4o

# ═══════════════════════════════════════════════════════════
# OPENAI (PAGO) — alternativa
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════
# RAG & EMBEDDINGS
# ═══════════════════════════════════════════════════════════
RETRIEVAL_METHOD=langchain
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ═══════════════════════════════════════════════════════════
# AGENT
# ═══════════════════════════════════════════════════════════
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true

# ═══════════════════════════════════════════════════════════
# JAVA API INTEGRATION
# ═══════════════════════════════════════════════════════════
# URL da API Java do JurisFlow (onde estão processos, prazos, clientes)
JAVA_API_URL=http://localhost:8082/api
