# AI Platform - Multi-Vertical Service - Configuração

# ═══════════════════════════════════════════════════════════
# VERTICAL (NICHO/DOMÍNIO)
# ═══════════════════════════════════════════════════════════
# Define qual configuração carregar de app/verticals/{vertical}/
# Verticais disponíveis: legal, (adicione mais conforme necessário)
AI_VERTICAL=legal

# ═══════════════════════════════════════════════════════════
# LLM PROVIDER
# ═══════════════════════════════════════════════════════════
# Opções: openrouter | azure | openai
# Se OpenRouter free atingir 50 req/dia, configure AZURE_OPENAI_KEY/ENDPOINT
# (ou OPENAI_API_KEY) para fallback automático.
LLM_PROVIDER=openrouter

# ═══════════════════════════════════════════════════════════
# OPENROUTER (GRÁTIS + PAGO) — https://openrouter.ai/keys
# ═══════════════════════════════════════════════════════════
# LLM — OpenRouter (modelos :free compartilham limite diário da conta)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Router automático entre modelos free (recomendado)
OPENROUTER_MODEL=openrouter/free
# Fallbacks se um provedor específico estiver congestionado (não aumenta o limite diário)
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=JurisFlow

# ═══════════════════════════════════════════════════════════
# AZURE OPENAI (PAGO) — para produção
# ═══════════════════════════════════════════════════════════
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_DEPLOYMENT_NAME=gpt-4o

# ═══════════════════════════════════════════════════════════
# OPENAI (PAGO) — alternativa
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════
# RAG & EMBEDDINGS
# ═══════════════════════════════════════════════════════════
RETRIEVAL_METHOD=langchain
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ═══════════════════════════════════════════════════════════
# AGENT
# ═══════════════════════════════════════════════════════════
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true

# ═══════════════════════════════════════════════════════════
# INTEGRATION API
# ═══════════════════════════════════════════════════════════
# URL da API de integração (backend do produto)
# Cada vertical pode ter sua própria URL. Use {VERTICAL}_API_URL.
JAVA_API_URL=http://localhost:8082/api      # Fallback global
LEGAL_API_URL=http://localhost:8082/api     # Vertical legal (JurisFlow)
# MEDICAL_API_URL=http://localhost:8083/api  # Exemplo: outro vertical

# ═══════════════════════════════════════════════════════════
# CORS & RATE LIMITING
# ═══════════════════════════════════════════════════════════
# Origens permitidas (separadas por vírgula) — restrinja em produção
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8082
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
