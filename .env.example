# ==================== JURISFLOW AI SERVICE ====================
# Motor de IA Jurídica — LangChain + RAG + Agents

# ==================== LLM PROVIDER ====================
# Opções: groq | azure | openai
LLM_PROVIDER=groq

# GROQ (GRÁTIS) — Recomendado para desenvolvimento
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile  # ou mixtral-8x7b-32768

# AZURE OPENAI (PAGO) — Para produção
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_DEPLOYMENT_NAME=gpt-4o

# OPENAI (PAGO) — Alternativa
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==================== RAG & EMBEDDINGS ====================
# Método de retrieval: langchain | tfidf | lexical
RETRIEVAL_METHOD=langchain

# Embeddings locais (gratuito, roda em CPU)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ==================== AGENT ====================
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true

# ==================== SERVER ====================
HOST=0.0.0.0
PORT=8090
